# Copy to .env.local (web) and .env (worker). Never commit the filled-in version.

# --- Database -------------------------------------------------------------
# Neon in production; locally, either a Neon dev branch or Postgres in Docker:
#   docker run -d -p 5432:5432 -e POSTGRES_PASSWORD=chessedu -e POSTGRES_USER=chessedu \
#     -e POSTGRES_DB=chessedu pgvector/pgvector:pg17
DATABASE_URL=postgres://chessedu:chessedu@localhost:5432/chessedu

# Postgres-backed test suites are skipped unless this is set. Point it at a throwaway database.
TEST_DATABASE_URL=postgres://chessedu:chessedu@localhost:5432/chessedu_test

# --- Auth (web) -----------------------------------------------------------
# openssl rand -base64 32
AUTH_SECRET=
# Google Cloud console > Credentials > OAuth 2.0 Client ID (Web application).
# Authorised redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Required in production so Auth.js builds absolute callback URLs correctly.
AUTH_URL=http://localhost:3000

# --- Chess.com ------------------------------------------------------------
# Goes into the User-Agent. Chess.com blocks requests without a descriptive one.
CHESSCOM_CONTACT=you@example.com

# --- Coaching (web, server-side only) -------------------------------------
ANTHROPIC_API_KEY=

# --- Worker ---------------------------------------------------------------
STOCKFISH_PATH=/usr/games/stockfish
STOCKFISH_DEPTH=16
STOCKFISH_THREADS=2
STOCKFISH_HASH_MB=512
IDLE_POLL_MS=5000
